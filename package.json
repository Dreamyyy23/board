{
  "name": "obscur-sixfold-road",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n TABLE,REALTIME -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vinext dev",
    "dev:server": "node --watch server/server.mjs",
    "build": "vinext build && node scripts/prune-sites-build.mjs",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/publish-pages.mjs",
    "simulate": "node scripts/simulate.mjs",
    "start": "vinext start",
    "start:server": "node server/server.mjs",
    "simulate:baseline": "node scripts/simulate-baseline.mjs",
    "test": "node --test tests/*.test.mjs && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
